# Base URL of the demo backend API (required; there is no fallback host).
# The Socket.IO URL is derived from this (same host, without /api/v1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5050/api/v1

# Browser alerts (Firebase Cloud Messaging) are OPTIONAL and off while these are empty.
# Create your own Firebase project and web app (see ../docs/FIREBASE_SETUP.md), then paste
# the values here (in .env.local, not committed). The service worker (public/sw.js) is
# regenerated from them by `npm run dev` / `npm run build`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push certificate key pair (public key) from Project settings > Cloud Messaging.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
