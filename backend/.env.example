# TradeHub Demo backend - environment template.
# Copy to .env (gitignored) for local runs:  cp .env.example .env
# Everything here is demo-only. Never put real credentials in this project.

# --- Demo mode -------------------------------------------------------------
# When true the server refuses to start unless it is pointed at a LOCAL mongod
# whose database name contains "demo" and no Firebase/SMTP/API keys are set.
DEMO_MODE=true

# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=5050
HOST=localhost
# Base URL used when building absolute media URLs (defaults to http://localhost:$PORT)
PUBLIC_BASE_URL=http://localhost:5050

# --- Database (local single-node replica set; transactions require it) ---------
# scripts/dev/start-mongo.sh starts it on port 27018 (so it never clashes with a
# MongoDB you already run on 27017). Use 27017 here only if that is where your
# own local replica set (rs0) listens.
MONGODB_URI=mongodb://127.0.0.1:27018/tradehub_demo?replicaSet=rs0

# --- Auth ----------------------------------------------------------------------
# Random demo-only secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-demo-only-string
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d
# Comma-separated admin emails eligible for magic-link login (SMTP required, unused in demo).
ADMIN_EMAILS=
MAGIC_LINK_EXPIRY_MINUTES=5

# --- CORS / frontends ----------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ADMIN_PANEL_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# --- Rate limiting / proxy -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200
TRUST_PROXY_HOPS=1

# --- File storage --------------------------------------------------------------
# Demo uses local disk only. Demo catalogue images are served from assets/demo-images
# at /uploads/demo/*; new uploads go to LOCAL_UPLOADS_DIR (default ./uploads).
FILE_STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=uploads
PRIVATE_MEDIA_SIGNED_URL_TTL_SECONDS=900

# --- Checkout / payments (WhatsApp checkout is disabled in the demo) ------------
PUBLIC_ORDER_WHATSAPP_NUMBER=
DEFAULT_UPI_ID=
DEFAULT_UPI_NAME=

# --- Third-party services: MUST stay blank in demo mode ---------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
GOOGLE_TRANSLATE_API_KEY=
