# Template of clients/<slug>/.env, which ./new-client.sh generates for you (with fresh secrets and your MongoDB URL).
# You normally never copy this file; it documents every variable. All values are fictional.
# After editing a real client's .env run ./update-client.sh <slug> to apply the change.
# Values are double-quoted; do not use  "  \  $  or backticks inside them.

# --- Identity ------------------------------------------------------------------
CLIENT_SLUG="acme"                    # compose project = demomart-<slug>
CLIENT_NAME="Acme Traders"            # display name
DOMAIN="acme.localhost"               # *.localhost = plain HTTP for local tests; a real domain = automatic HTTPS
TLS_MODE="local"                      # local | auto (Caddy gets certificates) | proxy (TLS ended by another proxy)

# --- Hostnames and public URLs (what browsers use) --------------------------------
API_HOST="api.acme.localhost"
ADMIN_HOST="admin.acme.localhost"
SITE_HOST="acme.localhost"
API_ADDR="http://api.acme.localhost"  # Caddy site addresses ("http://" prefix = no TLS)
ADMIN_ADDR="http://admin.acme.localhost"
SITE_ADDR="http://acme.localhost"
PUBLIC_API_URL="http://api.acme.localhost:20000"      # baked into the admin and site builds; also media URLs
PUBLIC_ADMIN_URL="http://admin.acme.localhost:20000"
PUBLIC_SITE_URL="http://acme.localhost:20000"

# --- Host ports (one block of 5 per client) ----------------------------------------
PORT_BASE="20000"
PROXY_BIND="127.0.0.1"                # 0.0.0.0 only for automatic HTTPS on a public server
PROXY_HTTP_PORT="20000"               # proxy http  (80 with --standard-ports)
PROXY_HTTPS_PORT="20001"              # proxy https (443 with --standard-ports)
BACKEND_PORT="20002"                  # API direct, loopback only (debugging)
ADMIN_PORT="20003"                    # admin panel direct, loopback only
SITE_PORT="20004"                     # site direct, loopback only

# --- Database (yours, NOT part of this stack) -----------------------------------------------
# Atlas / any MongoDB replica set (transactions are used). Percent-encode special characters in the password.
# Single quotes on purpose: docker compose must not interpolate "$" inside the value.
# A MongoDB on the Docker host: mongodb://host.docker.internal:27017/acme_prod?directConnection=true
MONGODB_URI='mongodb+srv://user:password@cluster0.example.mongodb.net/acme_prod?retryWrites=true&w=majority'
MONGO_DB_NAME="acme_prod"             # database named in the URL; used by backup/export
MONGO_TOOLS_IMAGE="mongo:7"           # throw-away container image that runs mongodump for backups/exports

# --- API ----------------------------------------------------------------------------------
NODE_ENV="production"                # DEMO_MODE is always false in a deployed client
JWT_SECRET="generated-by-new-client-sh-64-hex-characters"   # >= 32 chars; new-client.sh creates 64
JWT_REFRESH_SECRET="generated-separately"
JWT_ACCESS_EXPIRY="2h"
JWT_REFRESH_EXPIRY="7d"
TRUST_PROXY_HOPS="1"                  # the per-client Caddy is the single proxy in front of the API
CORS_ORIGIN="http://admin.acme.localhost:20000,http://acme.localhost:20000"   # exact browser origins, no wildcards

# --- First admin ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@acme.localhost"    # created by new-client.sh
ADMIN_EMAILS="admin@acme.localhost"   # who may request an emailed sign-in link (needs SMTP)

# --- Brand (shown in notifications, receipts, exports) --------------------------------------
BRAND_NAME="Acme Traders"
BRAND_SHORT_NAME="Acme"
BRAND_LEGAL_NAME="Acme Traders"
BRAND_EMAIL="hello@acme.localhost"
BRAND_PHONE="+91 00000 00000"
BRAND_ADDRESS="100 Sample Street, Sample City"
BRAND_WEBSITE="http://acme.localhost:20000"

# --- Optional mail server for admin magic-link emails (blank = none) -----
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
